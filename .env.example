SECRET_KEY=replace-with-a-random-secret-generated-locally
# SQLite is the default for local Windows development.
DATABASE_URL=sqlite:///swms.db
POSTGRES_USER=swms
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
POSTGRES_DB=swms
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=5
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Set INSTALL_AI=1 to bake TensorFlow into the Docker image
INSTALL_AI=0
CONTACT_EMAIL=support@example.com
